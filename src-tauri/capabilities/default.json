{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "PDF小僧のデフォルト権限",
  "windows": ["main"],
  "platforms": ["windows", "linux", "macOS"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://github.com/**/*" },
        { "url": "https://ghostscript.com/**/*" },
        { "url": "https://localhost:*/**/*" },
        { "url": "https://asset.localhost:*/**/*" }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "shell:default",
    "process:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:read-files",
    "fs:read-dirs"
  ]
}
