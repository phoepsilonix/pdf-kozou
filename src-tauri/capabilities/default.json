{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "PDF小僧のデフォルト権限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-create-dir",
    "fs:allow-exists",
    "fs:allow-remove-file",
    "fs:allow-rename",
    "shell:default",
    "process:default"
  ]
}
