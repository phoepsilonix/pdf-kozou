{
  "identifier": "mobile",
  "description": "PDF小僧のモバイル(Android/iOS)向け権限。default.json は platforms が windows/linux/macOS 限定のため、モバイルではここで別途許可する必要がある。",
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:webview:allow-set-webview-zoom",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:default",
    "fs:allow-mkdir",
    "fs:read-files",
    "fs:read-dirs",
    "fs:write-files",
    "fs:allow-appcache-meta",
    "fs:allow-appcache-meta-recursive",
    "fs:allow-appcache-read",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appcache-write",
    "fs:allow-appcache-write-recursive",
    "fs:allow-cache-meta",
    "fs:allow-cache-meta-recursive",
    "fs:allow-cache-read",
    "fs:allow-cache-read-recursive",
    "fs:allow-cache-write",
    "fs:allow-cache-write-recursive"
  ]
}
