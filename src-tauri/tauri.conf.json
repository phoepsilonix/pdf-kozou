{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF-Kozou",
  "version": "../package.json",
  "identifier": "love.phoepsilonix.pdf-kozou",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cargo build -p pdf-kozou-core && npm run dev",
    "beforeBuildCommand": "cargo build -p pdf-kozou-core --release && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Kozou",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: data:; script-src 'self' 'unsafe-eval' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "targets": ["deb", "appimage", "rpm", "msi", "nsis"],
    "license": "../AGPL-3.0-or-later.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../target/release/pdf-kozou-core -> .",
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Open with PDF Kozou",
        "mimeType": "application/pdf"
      }
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0",
          "libglib2.0-0",
          "libcairo2",
          "libpango-1.0-0"
        ]
      },
      "rpm": {
        "depends": ["gtk3", "webkit2gtk4.1", "glib2", "cairo", "pango"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "installerHooks": "nsis/install.nsh",
        "displayLanguageSelector": true,
        "languages": ["Japanese", "English"]
      }
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1
    }
  }
}
