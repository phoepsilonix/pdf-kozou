{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF小僧",
  "version": "1.0.0",
  "identifier": "love.phoepsilonix.pdf-kozou",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cargo build -p pdf-kozou-core && npm run dev",
    "beforeBuildCommand": "cargo build -p pdf-kozou-core --release && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PDF小僧",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
	"devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "PDF小僧で開く",
        "mimeType": "application/pdf"
      }
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0",
          "libglib2.0-0",
          "libcairo2",
          "libpango-1.0-0"
        ]
      },
      "rpm": {
        "depends": [
          "gtk3",
          "webkit2gtk4.1",
          "glib2",
          "cairo",
          "pango"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1
    }
  }
}
