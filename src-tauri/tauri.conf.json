{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF-Kozou",
  "version": "../package.json",
  "identifier": "phoepsilonix.PDF-Kozou",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBundleCommand": "",
    "beforeBuildCommand": "pnpm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "PDF Kozou",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: data:; script-src 'self' 'unsafe-eval' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "license": "../AGPL-3.0-or-later.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Open with PDF Kozou",
        "mimeType": "application/pdf"
      }
    ]
  }
}
