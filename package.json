{
  "name": "pdf-kozou",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev:core": "cargo build --bin pdf-kozou-core",
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "tauri:dev2": "tauri dev",
    "build:core": "cargo build --release --bin pdf-kozou-core",
    "build:frontend": "tsc && vite build",
    "build": "tauri build",
    "build:android": "tauri android build --apk",
    "build:android:debug": "tauri android build --debug --apk",
    "tauri:android:build": "npx --no-install tauri android build --apk --aab --ci",
    "tauri:ios:build": "npx --no-install tauri ios build --ci --no-sign"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "prettier": "^3.8.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  }
}
