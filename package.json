{
  "name": "pdf-kozou",
  "private": true,
  "version": "1.8.15",
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "tauri": "tauri",
    "dev:core": "cargo build --bin pdf-kozou-core",
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "tauri:dev2": "tauri dev",
    "build:core": "cargo build --release --bin pdf-kozou-core",
    "build:frontend": "tsc && vite build",
    "build": "tauri build",
    "build:android": "tauri android build --apk",
    "build:android:debug": "tauri android build --debug --apk",
    "tauri:android:build": "pnpm exec --no-install tauri android build --apk --aab --ci",
    "tauri:ios:build": "pnpm exec --no-install tauri ios build --ci --no-sign",
    "version": "echo $npm_package_version"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pnpm": "^11.27.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
